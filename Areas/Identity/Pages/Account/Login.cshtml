@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<header>
    <h1>Veterinaria Tu Mascota Feliz</h1>
    <p>Cuidamos lo que más amas</p>
</header>

<section class="hero">
    <h1>@ViewData["Title"]</h1>
    <div class="card" style="max-width: 500px; width: 100%;">
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div>
                <label asp-for="Input.Email">Correo electrónico</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Input.Password">Contraseña</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div style="margin-bottom: 1rem;">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">Recordarme</label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-success">Ingresar</button>

            <div style="margin-top: 1rem;">                
                <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">¿No tienes cuenta? Regístrate</a></p>                
            </div>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <hr />
            <h3>Iniciar sesión con otro servicio</h3>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name">
                        @provider.DisplayName
                    </button>
                }
            </form>
        }
    </div>
</section>

<footer>
    <p>&copy; 2025 Veterinaria Tu Mascota Feliz. Todos los derechos reservados.</p>
</footer>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    header {
        background-color: #4CAF50;
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
    }

        .hero h1 {
            margin-bottom: 1rem;
            font-size: 2rem;
            color: #4CAF50;
        }

    .card {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        width: 100%;
        text-align: left;
    }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        margin-top: 0.25rem;
        margin-bottom: 0.75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .btn-success {
        background-color: #4CAF50;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #45a049;
        }

    .btn-primary {
        background-color: #007BFF;
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        margin-top: 0.5rem;
        cursor: pointer;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .text-danger {
        color: red;
        font-size: 0.9rem;
    }

    footer {
        background-color: #333;
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 2rem;
    }
</style>
