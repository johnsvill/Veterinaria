@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<header>
    <h1>Veterinaria Tu Mascota Feliz</h1>
    <p>Cuidamos lo que más amas</p>
</header>

<section class="hero">
    <h1>Regístrate para cuidar a tu mascota</h1>
    <div class="card" style="max-width: 500px; width: 100%;">
        <form method="post">
            <div>
                <label asp-for="Input.Email">Correo electrónico</label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.Password">Contraseña</label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success" style="margin-top: 1rem;">Crear cuenta</button>
        </form>
    </div>
</section>

<footer>
    <p>&copy; 2025 Veterinaria Tu Mascota Feliz. Todos los derechos reservados.</p>
</footer>

<style>
    header {
        background-color: #4CAF50;
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
    }

        .hero h1 {
            margin-bottom: 1rem;
            font-size: 2rem;
            color: #4CAF50;
        }

    .card {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        margin-top: 0.25rem;
        margin-bottom: 0.75rem;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .btn-success {
        background-color: #4CAF50;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-success:hover {
            background-color: #45a049;
        }

    .text-danger {
        color: red;
        font-size: 0.9rem;
    }

    footer {
        background-color: #333;
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 2rem;
    }
</style>

