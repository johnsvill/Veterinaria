@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registro confirmado";
}

<header>
    <h1>Veterinaria Tu Mascota Feliz</h1>
    <p>Cuidamos lo que más amas</p>
</header>

<section class="hero">
    <h1>@ViewData["Title"]</h1>
    <div class="card" style="max-width: 500px; width: 100%;">
        @{
            if (Model.DisplayConfirmAccountLink)
            {
                <p>Este Email no es real, es solo para la demo del proyecto!</p>
            }
            else
            {
                <p>Favor verifique su Email para activar la cuenta.</p>
            }
        }
    </div>
</section>

<footer>
    <p>&copy; 2025 Veterinaria Tu Mascota Feliz. Todos los derechos reservados.</p>
</footer>

<style>
    header {
        background-color: #4CAF50;
        color: white;
        padding: 2rem;
        text-align: center;
    }

    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
    }

        .hero h1 {
            margin-bottom: 1rem;
            font-size: 2rem;
            color: #4CAF50;
        }

    .card {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        text-align: center;
    }

    footer {
        background-color: #333;
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 2rem;
    }
</style>


