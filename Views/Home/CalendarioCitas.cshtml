<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

<!-- FullCalendar CSS -->
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />

<!-- FullCalendar JS (versión global) -->
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

<!-- jQuery y Bootstrap -->
<script src="/lib/jquery/dist/jquery.min.js"></script>
<script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<div id="calendario" class="border rounded shadow-sm p-2"></div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const calendarioEl = document.getElementById('calendario');

            const calendario = new window.FullCalendar.Calendar(calendarioEl, {
                initialView: 'dayGridMonth',
                locale: 'es',
                timeZone: 'local', // Asegura que se respete la hora local
                height: 'auto',
                firstDay: 1,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'Hoy',
                    month: 'Mes',
                    week: 'Semana',
                    day: 'Día'
                },
                events: {
                    url: '/Home/ObtenerEventosCalendario',
                    failure: function () {
                        alert('Error al cargar eventos.');
                    }
                },
                eventDidMount: function (info) {
                    new bootstrap.Tooltip(info.el, {
                        title: info.event.title,
                        placement: 'top',
                        trigger: 'hover',
                        container: 'body'
                    });
                },
                eventDisplay: 'block',
                dayMaxEventRows: false,
                slotMinTime: '08:00:00',
                slotMaxTime: '17:00:00',
                allDaySlot: false // Evita que los eventos se muestren como de día completo
            });

            calendario.render();
        });
    </script>
}

<style>
    /* Encabezado verde */
    header {
        background-color: #4CAF50;
        color: white;
        padding: 2rem;
        text-align: center;
        font-family: 'Segoe UI', sans-serif;
    }

    /* Título de sección */
    .hero h1 {
        margin-top: 2rem;
        font-size: 2rem;
        color: #4CAF50;
        font-weight: bold;
        text-align: center;
    }

    /* Tabla personalizada */
    .table {
        font-size: 0.95rem;
        background-color: #fff;
        border-radius: 8px;
        overflow: hidden;
    }

        .table thead.thead-dark th {
            background-color: #388E3C;
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .table tbody td {
            vertical-align: middle;
            text-align: center;
        }

    /* Botones CRUD */
    .btn-primary {
        background-color: #2E7D32;
        border-color: #2E7D32;
    }

        .btn-primary:hover {
            background-color: #1B5E20;
            border-color: #1B5E20;
        }

    .btn-danger {
        background-color: #C62828;
        border-color: #C62828;
    }

        .btn-danger:hover {
            background-color: #B71C1C;
            border-color: #B71C1C;
        }

    /* Caption personalizado */
    caption {
        caption-side: top;
        text-align: center;
        padding: 1rem;
        font-size: 1rem;
    }

    /* Footer */
    footer {
        background-color: #2E7D32;
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 2rem;
        font-size: 0.9rem;
    }

    .table thead.thead-dark th {
        background-color: #388E3C; /* verde */
        color: white;
    }

</style>