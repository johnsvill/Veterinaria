@model IEnumerable<Veterinaria.Models.ListaMascotas>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" />

<header>
    <h1>Veterinaria Tu Mascota Feliz</h1>
    <p>Cuidamos lo que más amas</p>
</header>
<br />

<!-- Botón para abrir la modal -->
<button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#modalCrearMascota">
    <i class="fas fa-paw"></i> Registrar nueva mascota
</button>

<table class="table text-center text-bold table-bordered table-hover table-sm table-responsive-xl pre-scrollable">
    <thead class="thead-dark">
        <tr>
            <th>Foto</th>
            <th>@Html.DisplayNameFor(model => model.First().NombreMascota)</th>
            <th>@Html.DisplayNameFor(model => model.First().Especie)</th>
            <th>@Html.DisplayNameFor(model => model.First().Raza)</th>
            <th>@Html.DisplayNameFor(model => model.First().FechaNac)</th>
            <th>@Html.DisplayNameFor(model => model.First().PesoLibras)</th>
            <th>@Html.DisplayNameFor(model => model.First().NombrePersona)</th>
            <th>@Html.DisplayNameFor(model => model.First().Telefono)</th>
            <th>@Html.DisplayNameFor(model => model.First().Direccion)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mascota in Model)
        {
            <tr>
                <td>                   
                    <img src="~/imagenes/@mascota.Foto" alt="Mascota" width="80" height="80" class="rounded shadow-sm" />
                </td>
                <td>@mascota.NombreMascota</td>
                <td>@mascota.Especie</td>
                <td>@mascota.Raza</td>
                <td>@mascota.FechaNac.ToString("dd/MM/yyyy")</td>
                <td>@mascota.PesoLibras.ToString("F2") lb</td>
                <td>@mascota.NombrePersona</td>
                <td>@mascota.Telefono</td>
                <td>@mascota.Direccion</td>
                <td>
                    <!-- Botón Editar -->
                    <button type="button" class="btn btn-primary btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEditar_@mascota.IdMascota">
                        <i class="fas fa-pencil-alt"></i> Editar
                    </button>

                    <!-- Botón Eliminar -->
                    <button type="button" class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#modalEliminar_@mascota.IdMascota">
                        <i class="fas fa-trash-alt"></i> Eliminar
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>

@foreach (var mascota in Model)
{
    <div class="modal fade" id="modalEditar_@mascota.IdMascota" tabindex="-1" aria-labelledby="editarLabel_@mascota.IdMascota" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="EditarMascota" method="post" enctype="multipart/form-data">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="editarLabel_@mascota.IdMascota">Editar mascota</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="IdMascota" value="@mascota.IdMascota" />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" name="NombreMascota" class="form-control" value="@mascota.NombreMascota" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Especie</label>
                            <input type="text" name="Especie" class="form-control" value="@mascota.Especie" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Raza</label>
                            <input type="text" name="Raza" class="form-control" value="@mascota.Raza" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fecha de nacimiento</label>
                            <input type="date" name="FechaNac" class="form-control" value="@mascota.FechaNac.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Peso (lb)</label>
                            <input type="number" step="0.01" name="PesoLibras" class="form-control" value="@mascota.PesoLibras" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Foto actual</label><br />
                            <img src="~/imagenes/@mascota.Foto" alt="Foto mascota" width="100" class="rounded shadow-sm" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nueva foto</label>
                            <input type="file" name="Foto" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar_@mascota.IdMascota" tabindex="-1" aria-labelledby="eliminarLabel_@mascota.IdMascota" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="EliminarMascota" method="post">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="eliminarLabel_@mascota.IdMascota">Eliminar mascota</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Estás seguro que deseas eliminar a <strong>@mascota.NombreMascota</strong>?</p>
                        <input type="hidden" name="IdMascota" value="@mascota.IdMascota" />
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal -->
<div class="modal fade" id="modalCrearMascota" tabindex="-1" aria-labelledby="crearLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="CrearMascota" method="post" enctype="multipart/form-data">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="crearLabel">Registrar nueva mascota</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="Nombre" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Especie</label>
                        <input type="text" name="Especie" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Raza</label>
                        <input type="text" name="Raza" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Fecha de nacimiento</label>
                        <input type="date" name="FechaNac" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Peso (lb)</label>
                        <input type="number" step="0.01" name="PesoLibras" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Foto</label>
                        <input type="file" name="Foto" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">IdCliente</label>
                        <input readonly type="number" name="IdCliente" id="inputIdCliente" class="form-control" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Encabezado verde */
    header {
        background-color: #4CAF50;
        color: white;
        padding: 2rem;
        text-align: center;
        font-family: 'Segoe UI', sans-serif;
    }

    /* Título de sección */
    .hero h1 {
        margin-top: 2rem;
        font-size: 2rem;
        color: #4CAF50;
        font-weight: bold;
        text-align: center;
    }

    /* Tabla personalizada */
    .table {
        font-size: 0.95rem;
        background-color: #fff;
        border-radius: 8px;
        overflow: hidden;
    }

        .table thead.thead-dark th {
            background-color: #388E3C;
            color: white;
            font-weight: bold;
            text-align: center;
        }

        .table tbody td {
            vertical-align: middle;
            text-align: center;
        }

    /* Botones CRUD */
    .btn-primary {
        background-color: #2E7D32;
        border-color: #2E7D32;
    }

        .btn-primary:hover {
            background-color: #1B5E20;
            border-color: #1B5E20;
        }

    .btn-danger {
        background-color: #C62828;
        border-color: #C62828;
    }

        .btn-danger:hover {
            background-color: #B71C1C;
            border-color: #B71C1C;
        }

    /* Caption personalizado */
    caption {
        caption-side: top;
        text-align: center;
        padding: 1rem;
        font-size: 1rem;
    }

    /* Footer */
    footer {
        background-color: #2E7D32;
        color: white;
        text-align: center;
        padding: 1rem;
        margin-top: 2rem;
        font-size: 0.9rem;
    }

    .table thead.thead-dark th {
        background-color: #388E3C; /* verde */
        color: white;
    }

</style>

<script>
    function asignarIdClienteAleatorio() {
        const idAleatorio = Math.floor(Math.random() * 30) + 1;
        document.getElementById("inputIdCliente").value = idAleatorio;
    }

    // Ejecutar cuando se abre la modal
    const modalCrear = document.getElementById('modalCrearMascota');
    modalCrear.addEventListener('shown.bs.modal', asignarIdClienteAleatorio);
</script>
